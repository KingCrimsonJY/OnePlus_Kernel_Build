# ============================================================================
# OnePlus Ace Pro (sm8475 / 骁龙 8+ Gen 1) — LXC / Docker / systemd 内核补全片段
# 适用构建: android12-5.10 GKI (gki_defconfig 为基础)
# 所有符号均已对照真实 5.10 Kconfig 逐项核对 (torvalds v5.10 + OnePlusOSS sm8475 树)
#
# ★★★ 红线保护：以下 ACC 旁路充电相关节点【严禁改动/删除】，本片段不触碰它们 ★★★
#   CONFIG_QTI_BATTERY_CHARGER
#   CONFIG_QPNP_SMART_CHARGER
#   CONFIG_OPLUS_CHG=y / CONFIG_OPLUS_CHG_* (全部 oplus 充电系列)
#   CONFIG_OPLUS_SM8450_CHARGER=y
#   CONFIG_OPLUS_CHG_V1 / V2、CONFIG_OPLUS_BATTERY、CONFIG_OPLUS_SHORT_CIRCUIT_PROTECT 等
# 它们位于 vendor/waipio_GKI.config 片段中，与下方通用开关正交，互不影响。
# ============================================================================

# ---------------------------------------------------------------------------
# 1. 命名空间 (Namespaces) — LXC 容器隔离的基石
#    依赖: CONFIG_NAMESPACES (已启用，父开关)
# ---------------------------------------------------------------------------
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
# CONFIG_UTS_NS / CONFIG_NET_NS / CONFIG_MNT_NS 已由 NAMESPACES 启用，列出备查
CONFIG_UTS_NS=y
CONFIG_NET_NS=y

# ---------------------------------------------------------------------------
# 2. systemd 运行依赖
#    POSIX_MQUEUE: systemd 用于进程间 mq 通信
#    CGROUP_DEVICE: systemd 设备访问控制
#    AUDIT/AUDITSYSCALL: systemd 审计日志 (def_bool 依赖 AUDIT + HAVE_ARCH_AUDITSYSCALL)
#    SECURITY_APPARMOR: LXC/systemd 容器强制访问控制 (不改动 Android 默认 SELinux)
#    AUTOFS_FS: systemd automount 单元 (5.10 正确符号名，AUTOFS4_FS 仅为旧别名)
#    FANOTIFY: 可选，供 systemd 高级功能/安全工具使用
# ---------------------------------------------------------------------------
CONFIG_POSIX_MQUEUE=y
CONFIG_CGROUP_DEVICE=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_AUTOFS_FS=y
CONFIG_FANOTIFY=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y

# ---------------------------------------------------------------------------
# 3. cgroups — Docker / LXC 资源控制
#    依赖: CONFIG_CGROUPS (已启用，父开关)
# ---------------------------------------------------------------------------
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_RDMA=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_CFS_BANDWIDTH=y
# 以下已启用，列出备查: CGROUP_CPUACCT / CGROUP_FREEZER / CGROUP_SCHED /
# CPUSETS / MEMCG / BLK_CGROUP / CGROUP_NET_PRIO / CGROUP_BPF

# ---------------------------------------------------------------------------
# 4. 网络: Docker bridge / NAT / masquerade
#    BRIDGE_NETFILTER 依赖 BRIDGE + NETFILTER + INET
#    IP6_NF_NAT / IP6_NF_TARGET_MASQUERADE 补齐 IPv6 NAT
#    XT_MATCH_ADDRTYPE / IPVS: Docker 标准网络所需
# ---------------------------------------------------------------------------
CONFIG_BRIDGE_NETFILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y

# ---------------------------------------------------------------------------
# 5. 网络: IPVS (docker --network=ipvs 高性能模式)
#    依赖: CONFIG_IP_VS + NF_CONNTRACK
# ---------------------------------------------------------------------------
CONFIG_IP_VS=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=y
CONFIG_IP_VS_WRR=y
CONFIG_IP_VS_SH=y

# ---------------------------------------------------------------------------
# 6. 网络: nftables (Docker 可选后端) — 真实 5.10 符号名已核对
#    依赖: CONFIG_NF_TABLES (+ NETFILTER_XTABLES 供 COMPAT)
# ---------------------------------------------------------------------------
CONFIG_NF_TABLES=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_CT=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y

# ---------------------------------------------------------------------------
# 7. 网络: overlay / macvlan / ipvlan 驱动
#    VXLAN 依赖 INET, select NET_UDP_TUNNEL
#    BRIDGE_VLAN_FILTERING 依赖 BRIDGE + VLAN_8021Q
#    TUN: 容器内 VPN 支持
# ---------------------------------------------------------------------------
CONFIG_VXLAN=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_TUN=y

# ---------------------------------------------------------------------------
# 8. KernelSU-Next (Root 强控制态核心)
#    由 KernelSU-Next setup.sh 注入，符号名 CONFIG_KSU
# ---------------------------------------------------------------------------
CONFIG_KSU=y

# ---------------------------------------------------------------------------
# 9. SUSFS (Root 隐藏态) — 下列为已核对真实集成仓库的核心符号集
#    更多子项 (SUS_KSTAT / SUS_PROC / SUS_TMPFS 等) 按所选 SUSFS 版本 Kconfig 启用
# ---------------------------------------------------------------------------
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_PATH=y
# 注：SUS_SU 已在 SUSFS 2.0 (gki-android12-5.10) 被废弃，切勿设置，否则符号不存在
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_MANUAL_HOOK=y

# ---------------------------------------------------------------------------
# 10. BBR TCP 拥塞控制 + FQ 队列
#     依赖: CONFIG_TCP_CONG_ADVANCED + CONFIG_NET_SCH_FQ
#     关闭 BIC/WESTWOOD/HTCP 以避免默认竞争，保留 CUBIC 作回退
# ---------------------------------------------------------------------------
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_TCP_CONG_BIC=n
CONFIG_TCP_CONG_WESTWOOD=n
CONFIG_TCP_CONG_HTCP=n
CONFIG_TCP_CONG_CUBIC=y

# ---------------------------------------------------------------------------
# 10b. 服务器增强特性（一加 Ace Pro 24h 服务器场景，均为 5.10 真实符号）
# ---------------------------------------------------------------------------
# WireGuard VPN：远程安全接入服务器（5.10 已合入主线，CONFIG_WIREGUARD）
CONFIG_WIREGUARD=y
# ZRAM 内存压缩交换：16G 内存做常驻服务时的安全网（压缩器默认 lzo/rle）
CONFIG_ZRAM=y
# cgroup v2：Docker 现代默认层级，配合上方 cgroup v1 选项并存
CONFIG_CGROUP_V2=y
# CPU 调速器可用集（默认调速器保持 ROM 原值，运行时由开机脚本设定为 schedutil）
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
# 桥接 IGMP 侦听（若跑多播/服务发现更稳）
CONFIG_BRIDGE_IGMP_SNOOPING=y

# ---------------------------------------------------------------------------
# 11. 内核自述配置 — 便于刷入后用 check-config.sh 从 /proc/config.gz 复测
# ---------------------------------------------------------------------------
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# ---------------------------------------------------------------------------
# 12. KernelSU 调试开关 (生产环境建议保持关闭)
# ---------------------------------------------------------------------------
# CONFIG_KSU_DEBUG=n
